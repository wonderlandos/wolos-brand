[Icon Theme]
Name=WolOS
Comment=WolOS icons from the repo (dev and golden renders), design/tools/icons.py
Inherits=Adwaita,hicolor
Directories=apps,places,devices,mimetypes,symbolic

[apps]
Size=128
MinSize=16
MaxSize=1024
Context=Applications
Type=Scalable

[places]
Size=128
MinSize=16
MaxSize=1024
Context=Places
Type=Scalable

[devices]
Size=128
MinSize=16
MaxSize=1024
Context=Devices
Type=Scalable

[mimetypes]
Size=128
MinSize=16
MaxSize=1024
Context=MimeTypes
Type=Scalable

[symbolic]
Size=16
MinSize=16
MaxSize=512
Context=Status
Type=Scalable

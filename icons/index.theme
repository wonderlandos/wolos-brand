[Icon Theme]
Name=WolOS
Comment=WolOS (Wonderland OS) icon theme
Inherits=Adwaita,hicolor
Directories=scalable/apps,scalable/places,scalable/devices,scalable/mimetypes,symbolic/status,symbolic/actions

[scalable/apps]
Size=128
MinSize=16
MaxSize=1024
Context=Applications
Type=Scalable

[scalable/places]
Size=128
MinSize=16
MaxSize=1024
Context=Places
Type=Scalable

[scalable/devices]
Size=128
MinSize=16
MaxSize=1024
Context=Devices
Type=Scalable

[scalable/mimetypes]
Size=128
MinSize=16
MaxSize=1024
Context=MimeTypes
Type=Scalable

[symbolic/status]
Size=16
MinSize=16
MaxSize=512
Context=Status
Type=Scalable

[symbolic/actions]
Size=16
MinSize=16
MaxSize=512
Context=Actions
Type=Scalable

    {
     "enforced": "manual",
     "id": "RU-110",
     "kind": "do",
     "text": "A switch applies its change at once; no Save or Apply button follows it."
    },
    {
     "enforced": "manual",
     "id": "RU-111",
     "kind": "dont",
     "text": "Do not use a switch to start an action such as Install or Restart; use a button."
    },
    {
     "enforced": "RH-011",
     "id": "RU-112",
     "kind": "do",
     "text": "A change that leaves the process uses the pending switch: it waits, then shows the confirmed state (RC-01)."
    },
    {
     "enforced": "kit_components",
     "id": "RU-113",
     "kind": "do",
     "text": "A switch in a row is named by the row title and described by its subtitle for assistive technology."
    }
